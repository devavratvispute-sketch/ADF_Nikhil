{
	"name": "PL_Bronze_Load",
	"properties": {
		"activities": [
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.extract_type,'FILE')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy_Landing_To_Bronze",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "SP_Insert_Audit",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Landing_CSV",
									"type": "DatasetReference",
									"parameters": {
										"Container": {
											"value": "@pipeline().parameters.extract_container",
											"type": "Expression"
										},
										"FolderPath": {
											"value": "@pipeline().parameters.extract_path",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(pipeline().parameters.extract_name,'.csv')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_CSV_sink",
									"type": "DatasetReference",
									"parameters": {
										"Container": "@pipeline().parameters.target_container",
										"FolderPath": "@pipeline().parameters.target_path",
										"FileName": {
											"value": "@concat(\n    pipeline().parameters.extract_name,\n    '_',\n    formatDateTime(utcNow(),'yyyyMMddHHmmss'),\n    '.csv'\n)",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "SP_Insert_Audit",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_Insert_Audit]",
								"storedProcedureParameters": {
									"extract_id": {
										"value": "@pipeline().parameters.extract_id",
										"type": "Int32"
									},
									"run_id": {
										"value": "@pipeline().RunId",
										"type": "String"
									},
									"status": {
										"value": "Started",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Update_Audit",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_Landing_To_Bronze",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_Update_Audit]",
								"storedProcedureParameters": {
									"error_message": {
										"value": "NULL",
										"type": "String"
									},
									"run_id": {
										"value": "@pipeline().RunId",
										"type": "String"
									},
									"source_count": {
										"value": "0",
										"type": "Int32"
									},
									"status": {
										"value": "SUCCESS",
										"type": "String"
									},
									"target_count": {
										"value": "0",
										"type": "Int32"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Insert_Error",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_Landing_To_Bronze",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_Insert_Error]",
								"storedProcedureParameters": {
									"activity_name": {
										"value": "Copy_Landing_To_Bronze",
										"type": "String"
									},
									"error_code": {
										"value": {
											"value": "NULL",
											"type": "Expression"
										},
										"type": "String"
									},
									"error_message": {
										"value": {
											"value": "Null",
											"type": "Expression"
										},
										"type": "String"
									},
									"extract_id": {
										"value": "@pipeline().parameters.extract_id",
										"type": "Int32"
									},
									"pipeline_name": {
										"value": "@pipeline().Pipeline",
										"type": "String"
									},
									"run_id": {
										"value": "@pipeline().RunId",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "AzureSqlDatabase",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"extract_name": {
				"type": "string"
			},
			"extract_type": {
				"type": "string"
			},
			"extract_container": {
				"type": "string"
			},
			"extract_path": {
				"type": "string"
			},
			"target_container": {
				"type": "string"
			},
			"target_path": {
				"type": "string"
			},
			"extract_load_type": {
				"type": "string"
			},
			"extract_id": {
				"type": "int"
			}
		},
		"annotations": []
	}
}