{
	"name": "PL_Bronze_Load",
	"properties": {
		"activities": [
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(pipeline().parameters.extract_type,'FILE')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Wait1",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 1
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy_Landing_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Landing_CSV",
									"type": "DatasetReference",
									"parameters": {
										"Container": {
											"value": "@pipeline().parameters.extract_container",
											"type": "Expression"
										},
										"FolderPath": {
											"value": "@pipeline().parameters.extract_path",
											"type": "Expression"
										},
										"FileName": {
											"value": "@concat(pipeline().parameters.extract_name,'.csv')",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Bronze_CSV_sink",
									"type": "DatasetReference",
									"parameters": {
										"Container": "@pipeline().parameters.target_container",
										"FolderPath": "@pipeline().parameters.target_path",
										"FileName": {
											"value": "@concat(pipeline().parameters.extract_name,'.csv')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"extract_name": {
				"type": "string"
			},
			"extract_type": {
				"type": "string"
			},
			"extract_container": {
				"type": "string"
			},
			"extract_path": {
				"type": "string"
			},
			"target_container": {
				"type": "string"
			},
			"target_path": {
				"type": "string"
			},
			"extract_load_type": {
				"type": "string"
			}
		},
		"annotations": []
	}
}